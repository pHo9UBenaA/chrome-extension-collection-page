---
import { SITE_AUTHOR, SITE_AUTHOR_ID } from '../consts';

const today = new Date();
---

<footer>
	<div>
		&copy; {today.getFullYear()} {SITE_AUTHOR} · {SITE_AUTHOR_ID}
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--border);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	footer div {
		padding: 2rem 1rem;
	}
</style>
