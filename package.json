{
	"name": "chrome-extension-collection-page",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "node scripts/serve.mjs",
		"build": "node scripts/build.mjs",
		"preview": "pnpm run build && node scripts/serve.mjs --dist",
		"deploy": "pnpm run build && wrangler pages deploy",
		"test:ci": "CI=true playwright test",
		"ci": "biome ci . --error-on-warnings",
		"format": "pnpm run format:biome && pnpm run format:prettier",
		"format:biome": "biome format --write .",
		"format:prettier": "prettier --write \"**/*.md\" \"public/*.html\"",
		"lint": "biome lint --write . --error-on-warnings",
		"check": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@playwright/test": "1.62.1",
		"prettier": "3.9.6",
		"wrangler": "4.128.0"
	}
}
